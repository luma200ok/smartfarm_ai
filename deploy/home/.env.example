# 홈서버 이전 도커화(이슈 #68) — deploy/home/compose.yml 용 환경변수.
# 실제 값을 채운 .env 파일은 절대 커밋하지 말 것(.gitignore 확인) — chmod 600 권장.
# 아래 값은 전부 더미/예시이며 실제 시크릿이 아니다.

# --- 호스트 데이터 루트(절대경로) — models/·data/ 가 이 경로 하위에서 바인드 마운트됨 ---
# sudo 헬퍼(root)로 compose를 실행하므로 ~ 대신 절대경로 필수(미설정 시 compose가 즉시 실패)
DATA_DIR=/home/jb/srv/smartfarm-ai

# --- Ollama (호스트에서 별도 구동 중이라고 가정 — 이 스택엔 포함하지 않음) ---
# Linux에서 host.docker.internal 사용은 compose의 extra_hosts(host-gateway)가 가능하게 함
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_HOST=http://host.docker.internal:11434
EMBED_MODEL=bge-m3
# 처방 fast-path 최종 작성 전용 모델(선택, 미설정 시 OLLAMA_MODEL 사용)
OLLAMA_WRITER_MODEL=exaone3.5:2.4b
# Ollama 콜드 스타트 감안 보수적 기본값(초). 미설정 시 코드 기본값 180 사용
OLLAMA_TIMEOUT=180

# --- PostgreSQL + pgvector — RAG 저장소·처방/경보 이력 (선택, 미설정 시 현행 npz+무이력 그대로) ---
# 기본값은 RAG_BACKEND 미설정(=npz+무이력 폴백) — pgvector 모드를 쓸 때만 아래 주석을 해제한다.
# 활성화 전 deploy/home/README.md §1의 db/schema.sql 적용 체크리스트를 먼저 완료할 것.
# RAG_BACKEND=pgvector
DATABASE_URL=postgresql://smartfarm:CHANGE_ME@db-postgres:5432/smartfarm_ai
# ⚠️ env 변경(RAG_BACKEND·DATABASE_URL)은 컨테이너 재기동 후 반영됨(런타임 재적용 안 됨).

# --- 기상청(KMA) 단기예보 API (공공데이터포털 발급) ---
KMA_SERVICE_KEY=CHANGE_ME
# 농장 좌표 — 미설정 시 서울 기본값(37.5665/126.9780) 사용, 실제 농장 좌표로 교체
FARM_LAT=37.5665
FARM_LON=126.9780

# --- 디스코드 알림 (기존 smartfarm 웹훅 URL 기입, 없으면 알림 비활성) ---
DISCORD_WEBHOOK_URL=
